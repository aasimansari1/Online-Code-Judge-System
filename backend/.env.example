# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Admin protection (sent as x-admin-token header from the frontend admin page)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Code execution engine
# Options: judge0 | mock
EXECUTION_ENGINE=judge0

# Judge0 configuration
# Public RapidAPI: https://judge0-ce.p.rapidapi.com  (set RAPIDAPI_KEY)
# Self-hosted:    http://localhost:2358              (no key needed)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Limits enforced before forwarding to Judge0
MAX_CODE_LENGTH=65536
DEFAULT_TIME_LIMIT=2
DEFAULT_MEMORY_LIMIT=256000
